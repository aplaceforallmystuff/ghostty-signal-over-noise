# Signal Over Noise – Dark
# Ink and cream with one accent, from the Signal Over Noise style guide (signalovernoise.at, 7 Nov 2026).
# One accent only: red marks what matters (errors, directories, the cursor). Every other ANSI colour is a
# shade of cream, so green/yellow/blue/magenta/cyan output reads as plain text by design.

background = #1A1A1A
foreground = #F7F4EA
cursor-color = #EF6351
cursor-text = #1A1A1A
selection-background = #3A3631
selection-foreground = #F7F4EA

# 0-7 normal, 8-15 bright
palette = 0=#5A5650
palette = 1=#E58978
palette = 2=#D4CFC4
palette = 3=#D4CFC4
palette = 4=#E58978
palette = 5=#D4CFC4
palette = 6=#D4CFC4
palette = 7=#D4CFC4
palette = 8=#AAA599
palette = 9=#EF6351
palette = 10=#F7F4EA
palette = 11=#F7F4EA
palette = 12=#EF6351
palette = 13=#F7F4EA
palette = 14=#F7F4EA
palette = 15=#FFFDF5
